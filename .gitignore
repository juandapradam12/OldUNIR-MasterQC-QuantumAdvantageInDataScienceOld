# ──────────────────────────────────────────────────────────────────────────────
# LaTeX
# ──────────────────────────────────────────────────────────────────────────────
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.nav
*.snm
*.vrb
*.dvi
*.ps
*.lol
# Documento/main.pdf versionado en git (compilar con: cd Documento && tectonic -X compile main.tex)

# ──────────────────────────────────────────────────────────────────────────────
# Python
# ──────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.so
*.egg
*.egg-info/
dist/
build/
.venv/
.venv*/
env/
venv/
.ipynb_checkpoints/

# ──────────────────────────────────────────────────────────────────────────────
# macOS
# ──────────────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
# copias " 2" que macOS crea al sincronizar o resolver conflictos
* 2
* 2.*

# ──────────────────────────────────────────────────────────────────────────────
# POCs — datos de entrada y salida (tamaño / privacidad)
# ──────────────────────────────────────────────────────────────────────────────
POCs/data/input/*
# Las figuras y las métricas de salida (CSV/JSON de resultados) se versionan: la tesis cita sus cifras
# y scripts/verificar_cifras_tesis.py las lee. Regenerar con POCs/scripts/ y los cuadernos.
!POCs/data/**/.gitkeep
!POCs/data/README.md

# ──────────────────────────────────────────────────────────────────────────────
# Carpetas ignoradas
# ──────────────────────────────────────────────────────────────────────────────
Ejemplos/
Experimentos/datos/*.json
Experimentos/resultados/*.png
Experimentos/resultados/*.pdf
Experimentos/resultados/*.csv
Experimentos/.ipynb_checkpoints
.env
.env.local
