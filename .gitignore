*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.nav
*.snm
*.vrb
*.dvi
*.ps
*.lol
# Documento/main.pdf versionado en git (compilar con: cd Documento && tectonic -X compile main.tex)

# ──────────────────────────────────────────────────────────────────────────────
# Python
# ──────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.so
*.egg
*.egg-info/
dist/
build/
.venv/
.venv*/
env/
venv/
.ipynb_checkpoints/

# ──────────────────────────────────────────────────────────────────────────────
# macOS
# ──────────────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store

# ──────────────────────────────────────────────────────────────────────────────
# POCs — datos de entrada y salida (tamaño / privacidad)
# ──────────────────────────────────────────────────────────────────────────────
POCs/data/input/*
# Figuras del TFM versionadas en git (regenerar con POCs/scripts/generar_*.py)
POCs/data/output/metrics/*.csv
POCs/data/output/metrics/*.json
!POCs/data/**/.gitkeep
!POCs/data/README.md

# ──────────────────────────────────────────────────────────────────────────────
# Carpetas ignoradas
# ──────────────────────────────────────────────────────────────────────────────
Ejemplos/
Experimentos/datos/*.json
Experimentos/resultados/*.png
Experimentos/resultados/*.pdf
Experimentos/resultados/*.csv
Experimentos/.ipynb_checkpoints
.env
.env.local
